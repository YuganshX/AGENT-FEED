{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "autonomous-persona-agent",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-01",
    "triggers": {
        "crons": ["0 */2 * * *"]
    },
    "d1_databases": [
        {
        "binding": "AGENT_DB",
        "database_name": "autonomous-persona-agent",
        "database_id": "fd429f12-7f36-4086-9387-ca8260d1452a"
        }
    ],
    "vars": {
        "GEMINI_MODEL": "gemini-3.6-flash",
        "BREETH_BASE_URL": "https://api.thebreeth.com",
        "TAVILY_BASE_URL": "https://api.tavily.com"
    }
}